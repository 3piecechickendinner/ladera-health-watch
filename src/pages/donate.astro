---
import BaseLayout from '../layouts/BaseLayout.astro';
import DonateCallout from '../components/DonateCallout.astro';
---

<BaseLayout
  title="Donate"
  description="Donate to fund independent research by USC and UCI into childhood cancer and environmental factors, with a focus on Ladera Ranch."
>
  <section class="mx-auto max-w-3xl px-5 pb-4 pt-10 sm:pt-14">
    <p class="font-display text-sm font-semibold uppercase tracking-[0.14em] text-gold-700">
      Fund independent research
    </p>
    <h1 class="mt-3 font-display text-4xl font-semibold leading-tight text-oak-900 sm:text-5xl">
      Donate
    </h1>
  </section>

  <section class="mx-auto max-w-3xl px-5 py-6">
    <DonateCallout />
  </section>
</BaseLayout>
