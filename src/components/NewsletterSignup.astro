---
// Flodesk-hosted signup form. `is:inline` on both scripts is required: these
// are third-party vendor scripts that must run exactly as provided (module/
// nomodule loader pair, then the form init call), not be bundled or
// transformed by Astro.
---

<div class="text-center">
  <h2 class="font-display text-2xl font-semibold text-oak-900 sm:text-3xl">
    Stay Informed. Stay Involved.
  </h2>

  <div class="mx-auto mt-5 max-w-md">
    <div id="fd-form-6a667e9848b25897cf9acacc"></div>
  </div>

  <p class="mx-auto mt-4 max-w-[55ch] text-sm leading-relaxed text-oak-700">
    Sign up to receive updates on health and environmental issues affecting Orange County,
    including research, public records, community meetings, and opportunities to get involved.
    No spam, just important updates from concerned residents.
  </p>
</div>

<script is:inline>
  (function (w, d, t, h, s, n) {
    w.FlodeskObject = n;
    var fn = function () {
      (w[n].q = w[n].q || []).push(arguments);
    };
    w[n] = w[n] || fn;
    var f = d.getElementsByTagName(t)[0];
    var v = '?v=' + Math.floor(new Date().getTime() / (120 * 1000)) * 60;
    var sm = d.createElement(t);
    sm.async = true;
    sm.type = 'module';
    sm.src = h + s + '.mjs' + v;
    f.parentNode.insertBefore(sm, f);
    var sn = d.createElement(t);
    sn.async = true;
    sn.noModule = true;
    sn.src = h + s + '.js' + v;
    f.parentNode.insertBefore(sn, f);
  })(window, document, 'script', 'https://assets.flodesk.com', '/universal', 'fd');
</script>

<script is:inline>
  window.fd('form', {
    formId: '6a667e9848b25897cf9acacc',
    containerEl: '#fd-form-6a667e9848b25897cf9acacc',
  });
</script>
